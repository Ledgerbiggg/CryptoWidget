<Window x:Class="CryptoWidget.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CryptoWidget"
        Width="280" Height="64"
        SizeToContent="Width"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="{Binding IsPinned}">
    <!-- 悬浮卡片：背景/边框/按钮透明度随配置联动，空白处可拖动 -->
    <Border x:Name="CardBorder"
            CornerRadius="10"
            Background="{Binding BackgroundBrush}"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
        <DockPanel>
            <!-- 右上角按钮行：仅保留关闭（隐藏到托盘）；置顶/设置已移到托盘右键菜单 -->
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="2,3,4,0"
                        Opacity="{Binding BackgroundOpacity}">
                <Button Style="{StaticResource CardButtonStyle}"
                        Command="{Binding CloseCommand}"
                        ToolTip="隐藏到托盘">
                    <TextBlock Text="×" FontSize="13" Margin="0,-1,0,0" />
                </Button>
            </StackPanel>

            <!-- 全局连接状态圆点：绿=已连，红=断线（仅最前面一个，可配置隐藏） -->
            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowConnectionStatus, Converter={StaticResource BoolToVisConverter}}">
                <Ellipse Width="6" Height="6"
                         Fill="{Binding IsConnected, Converter={StaticResource ConnectedToBrushConverter}}"
                         VerticalAlignment="Center" />
            </StackPanel>

            <!-- 币种行：横向排列，宽度随币种数自动扩展 -->
            <ItemsControl ItemsSource="{Binding Coins}" Margin="8,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                            <!-- 图标：CDN 加载成功显示图片，失败回退首字母色块 -->
                            <Grid Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding DataContext.ShowIcon, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                                <Ellipse Fill="{Binding InitialBrush}" />
                                <TextBlock Text="{Binding Initial}"
                                           Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Icon}" Width="18" Height="18"
                                       Visibility="{Binding IconLoaded, Converter={StaticResource BoolToVisConverter}}" />
                            </Grid>

                            <!-- 名称 -->
                            <TextBlock Text="{Binding Symbol}"
                                       Foreground="#E8ECF1" FontSize="12" FontWeight="SemiBold"
                                       Margin="7,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.ShowName, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- 价格 + 涨跌幅：小数位由 CoinItem 按最近 5 个价格稳定，宽度自适应不抖动 -->
                            <StackPanel Orientation="Vertical" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastText}"
                                           Foreground="{Binding LastBrush}" FontSize="12" FontWeight="SemiBold"
                                           Visibility="{Binding DataContext.ShowPrice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />
                                <TextBlock Text="{Binding ChangeText}"
                                           FontSize="10.5"
                                           Foreground="{Binding ChangePercent, Converter={StaticResource ChangeToBrushConverter}}"
                                           Visibility="{Binding DataContext.ShowChange, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
