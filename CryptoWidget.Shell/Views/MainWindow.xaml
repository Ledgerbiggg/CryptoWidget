<Window x:Class="CryptoWidget.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CryptoWidget"
        Width="280"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="{Binding IsPinned}">
    <!-- 悬浮卡片：背景/边框/按钮透明度随配置联动，空白处可拖动 -->
    <Border x:Name="CardBorder"
            CornerRadius="10"
            Background="{Binding BackgroundBrush}"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
        <DockPanel>
            <!-- 右上角按钮行：仅保留关闭（隐藏到托盘）；置顶/设置已移到托盘右键菜单 -->
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="2,3,4,0"
                        Opacity="{Binding BackgroundOpacity}">
                <Button Style="{StaticResource CardButtonStyle}"
                        Command="{Binding CloseCommand}"
                        ToolTip="隐藏到托盘">
                    <TextBlock Text="×" FontSize="13" Margin="0,-1,0,0" />
                </Button>
            </StackPanel>

            <!-- 全局连接状态圆点：绿=已连，红=断线（仅最前面一个，可配置隐藏） -->
            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowConnectionStatus, Converter={StaticResource BoolToVisConverter}}">
                <Ellipse Width="6" Height="6"
                         Fill="{Binding IsConnected, Converter={StaticResource ConnectedToBrushConverter}}"
                         VerticalAlignment="Center" />
            </StackPanel>

            <!-- 币种行：横向（默认）/竖向由配置切换，宽度随内容自适应 -->
            <ItemsControl ItemsSource="{Binding Coins}" Margin="8,8">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVerticalLayout}" Value="True">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemContainerStyle>
                    <!-- 竖排时币种单元间留 2px 纵向间距 -->
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                            <!-- 图标：尺寸随字号等比缩放；CDN 加载成功显示图片，失败回退首字母色块 -->
                            <Grid Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="6,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding DataContext.ShowIcon, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                                <Ellipse Fill="{Binding InitialBrush}" />
                                <TextBlock Text="{Binding Initial}"
                                           Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Icon}"
                                       Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding IconLoaded, Converter={StaticResource BoolToVisConverter}}" />
                            </Grid>

                            <!-- 名称：竖向布局时固定 5 字符宽（价格列对齐），横向保持自适应 -->
                            <TextBlock Text="{Binding Symbol}"
                                       Foreground="#E8ECF1"
                                       FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="{Binding DataContext.FontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Margin="7,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.ShowName, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsVerticalLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Width" Value="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SymbolWidthConverter}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 价格 + 涨跌幅：小数位按历史最大稳定，宽度自适应不抖动 -->
                            <StackPanel Orientation="Vertical" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastText}"
                                           Foreground="{Binding LastBrush}"
                                           FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="{Binding DataContext.FontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding DataContext.ShowPrice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />
                                <TextBlock Text="{Binding ChangeText}"
                                           FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{Binding ChangePercent, Converter={StaticResource ChangeToBrushConverter}}"
                                           Visibility="{Binding DataContext.ShowChange, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
