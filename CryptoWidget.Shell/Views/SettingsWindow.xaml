<Window x:Class="CryptoWidget.Shell.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CryptoWidget 设置"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF16181D"
        TextElement.Foreground="#E8ECF1"
        FontSize="12"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <!-- 深色背景下控件统一白字，避免默认黑字看不清 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8ECF1" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8ECF1" />
            <Setter Property="Background" Value="#2A2F3A" />
            <Setter Property="BorderBrush" Value="#3A4150" />
            <Setter Property="CaretBrush" Value="#E8ECF1" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8ECF1" />
            <Setter Property="Background" Value="#2A2F3A" />
            <Setter Property="BorderBrush" Value="#3A4150" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#2A2F3A" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
        <StackPanel Margin="18,14">

            <!-- 版本与更新：校验版本 + 快捷更新入口（置于设置最前） -->
            <TextBlock Text="版本" Style="{StaticResource SettingsGroupTitleStyle}" />
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right"
                        Content="{Binding CheckButtonText}"
                        Width="88"
                        Command="{Binding CheckUpdateCommand}"
                        Margin="8,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <!-- 有新版时按钮变橙色「立即更新」，醒目引导升级 -->
                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                    <Setter Property="Background" Value="#F7931A" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontWeight="SemiBold"
                           Foreground="#F7931A" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding UpdateStatus}" Foreground="#9AA4B2" FontSize="11" Margin="0,4,0,0" />

            <Separator Margin="0,12" />

            <!-- 币种管理：增删 + 上下箭头排序 + 每币种小数位 -->
            <TextBlock Text="币种" Style="{StaticResource SettingsGroupTitleStyle}" />
            <TextBlock Text="上下箭头调整顺序 · 小数位留空 = 原样显示 OKX 价格" Foreground="#7A8494" FontSize="11" Margin="0,-4,0,4" />
            <ListBox ItemsSource="{Binding Coins}"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#E8ECF1">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#E8ECF1" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <!-- 上下箭头排序：首位/末位自动忽略，顺序即主卡片展示顺序 -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Width="24" Padding="0" FontSize="12"
                                        Content="↑" ToolTip="上移"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Width="24" Padding="0" FontSize="12" Margin="2,0,0,0"
                                        Content="↓" ToolTip="下移"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>

                            <!-- 币种图标：CDN 加载成功显示图片，失败回退首字母色块 -->
                            <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Ellipse Fill="{Binding InitialBrush}" />
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                       Visibility="{Binding IconLoaded, Converter={StaticResource BoolToVisConverter}}" />
                            </Grid>

                            <Button DockPanel.Dock="Right"
                                    Content="删除"
                                    Width="52"
                                    Command="{Binding DataContext.RemoveCoinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Margin="6,0,0,0" />
                            <TextBox DockPanel.Dock="Right"
                                     Width="64"
                                     Margin="0,0,6,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding DecimalPlacesText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="价格小数位（留空=原样显示）" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Symbol}" Width="60" FontWeight="SemiBold"
                                       Foreground="#E8ECF1" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding InstId}" Foreground="#9AA4B2" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 新增币种 -->
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right"
                        Content="添加"
                        Width="56"
                        Command="{Binding AddCoinCommand}"
                        Margin="6,0,0,0" />
                <TextBox Text="{Binding NewSymbol, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         KeyDown="NewSymbolBox_KeyDown"
                         ToolTip="输入币种代码（如 ETH）自动拼 ETH-USDT，或直接输入完整交易对（如 PEPE-USDT）；回车直接添加" />
            </DockPanel>
            <TextBlock Text="{Binding ErrorText}" Foreground="#EF5350" FontSize="11" Margin="0,4,0,0" />

            <Separator Margin="0,12" />

            <!-- 显示开关 -->
            <TextBlock Text="显示" Style="{StaticResource SettingsGroupTitleStyle}" />
            <CheckBox Content="显示币种图标" IsChecked="{Binding ShowIcon}" Margin="0,2" />
            <CheckBox Content="显示币种名称" IsChecked="{Binding ShowName}" Margin="0,2" />
            <CheckBox Content="显示价格" IsChecked="{Binding ShowPrice}" Margin="0,2" />
            <CheckBox Content="显示涨跌幅" IsChecked="{Binding ShowChange}" Margin="0,2" />
            <CheckBox Content="显示连接状态圆点" IsChecked="{Binding ShowConnectionStatus}" Margin="0,2" />
            <TextBlock Text="价格颜色" Foreground="#9AA4B2" FontSize="11" Margin="0,10,0,4" />
            <ComboBox SelectedIndex="{Binding PriceColorModeIndex}"
                      PreviewMouseWheel="ComboBox_PreviewMouseWheel">
                <ComboBoxItem Content="黑色" />
                <ComboBoxItem Content="白色" />
                <ComboBoxItem Content="红绿（随涨跌跳动）" />
            </ComboBox>
            <TextBlock Text="涨跌幅" Foreground="#9AA4B2" FontSize="11" Margin="0,10,0,4" />
            <ComboBox SelectedIndex="{Binding ChangeModeIndex}"
                      PreviewMouseWheel="ComboBox_PreviewMouseWheel">
                <ComboBoxItem Content="无" />
                <ComboBoxItem Content="当日（+8时区）" />
                <ComboBoxItem Content="当日（UTC）" />
                <ComboBoxItem Content="24小时" />
            </ComboBox>
            <TextBlock Text="币种布局" Foreground="#9AA4B2" FontSize="11" Margin="0,10,0,4" />
            <ComboBox SelectedIndex="{Binding LayoutIndex}"
                      PreviewMouseWheel="ComboBox_PreviewMouseWheel">
                <ComboBoxItem Content="横向（默认）" />
                <ComboBoxItem Content="竖向" />
            </ComboBox>

            <Separator Margin="0,12" />

            <!-- 样式：字体 / 字号 / 粗细（字号变化会带动币种图标等比缩放） -->
            <TextBlock Text="样式" Style="{StaticResource SettingsGroupTitleStyle}" />
            <TextBlock Text="字体" Foreground="#9AA4B2" FontSize="11" Margin="0,6,0,4" />
            <ComboBox ItemsSource="{Binding FontFamilyOptions}"
                      SelectedItem="{Binding FontFamilyName}"
                      PreviewMouseWheel="ComboBox_PreviewMouseWheel" />
            <TextBlock Text="字号" Foreground="#9AA4B2" FontSize="11" Margin="0,10,0,4" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding FontSize, StringFormat={}{0:F0}px}"
                           Width="44" TextAlignment="Right"
                           Foreground="#9AA4B2" VerticalAlignment="Center" />
                <Slider Minimum="10" Maximum="24"
                        Value="{Binding FontSize}"
                        VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="粗细" Foreground="#9AA4B2" FontSize="11" Margin="0,10,0,4" />
            <ComboBox ItemsSource="{Binding FontWeightOptions}"
                      SelectedItem="{Binding FontWeightName}"
                      PreviewMouseWheel="ComboBox_PreviewMouseWheel" />

            <Separator Margin="0,12" />

            <!-- 热键：点击「录制」后按下组合键捕获（默认 Alt+1 显示/隐藏卡片） -->
            <TextBlock Text="热键" Style="{StaticResource SettingsGroupTitleStyle}" />
            <TextBlock Text="点击「录制」后按下组合键即可捕获（必须含修饰键），按 Esc 取消" Foreground="#7A8494" FontSize="11" Margin="0,-4,0,6" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right"
                        Width="64"
                        Command="{Binding RecordHotkeyCommand}"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="录制" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Text" Value="停止" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Border Background="#2A2F3A" BorderBrush="#3A4150" BorderThickness="1" CornerRadius="4"
                        Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HotkeyDisplay}" FontWeight="SemiBold" Foreground="#F7931A" />
                </Border>
            </DockPanel>
            <TextBlock Foreground="#EF5350" FontSize="11" Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Text" Value="🔴 请按键…（Esc 取消）" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Separator Margin="0,12" />

            <!-- 其他 -->
            <TextBlock Text="其他" Style="{StaticResource SettingsGroupTitleStyle}" />
            <CheckBox Content="开机自启" IsChecked="{Binding AutoStart}" Margin="0,2" />
            <TextBlock Text="代理（可选，如 http://127.0.0.1:7890）" Foreground="#9AA4B2" FontSize="11" Margin="0,10,0,4" />
            <TextBox Text="{Binding Proxy, UpdateSourceTrigger=LostFocus}"
                     VerticalContentAlignment="Center"
                     ToolTip="留空则走系统代理/环境变量" />

            <TextBlock Text="卡片背景透明度（越小越透明）" Foreground="#9AA4B2" FontSize="11" Margin="0,10,0,4" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}"
                           Width="48" TextAlignment="Right"
                           Foreground="#9AA4B2" VerticalAlignment="Center" />
                <Slider Minimum="0" Maximum="0.9"
                        Value="{Binding BackgroundOpacity}"
                        VerticalAlignment="Center" />
            </DockPanel>

            <!-- 显式保存：落盘全部配置（开关类改动已即时保存，此按钮兜底文本输入等） -->
            <Button Content="保存设置"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Padding="20,6"
                    FontWeight="SemiBold"
                    Background="#F7931A"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>
    </ScrollViewer>
</Window>
