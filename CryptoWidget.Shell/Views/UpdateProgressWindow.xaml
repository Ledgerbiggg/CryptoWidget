<Window x:Class="CryptoWidget.Shell.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件更新"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#FF16181D"
        TextElement.Foreground="#E8ECF1"
        FontSize="12">
    <!-- 更新下载进度：下载完成由调用方关闭窗口并启动安装程序 -->
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="TitleText" Text="正在下载更新…" FontSize="13" FontWeight="SemiBold" />
        <ProgressBar x:Name="Bar" Height="18" Margin="0,12,0,0" Minimum="0" Maximum="100" />
        <TextBlock x:Name="StatusText" Text="准备中…" FontSize="11" Foreground="#9AA4B2" Margin="0,8,0,0" />
    </StackPanel>
</Window>
