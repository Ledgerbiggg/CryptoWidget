<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CryptoWidget.Shell</RootNamespace>
    <AssemblyName>CryptoWidget.Shell</AssemblyName>
    <Version>0.1.0</Version>
    <!-- exe 图标：安装包快捷方式/资源管理器均显示比特币图标 -->
    <ApplicationIcon>Assets\btc.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CryptoWidget.Common\CryptoWidget.Common.csproj" />
    <ProjectReference Include="..\CryptoWidget.Models\CryptoWidget.Models.csproj" />
    <ProjectReference Include="..\CryptoWidget.Services\CryptoWidget.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Prism.Unity" Version="8.1.97" />
  </ItemGroup>

  <ItemGroup>
    <!-- btc.ico 供窗口图标 pack URI 读取；EmbeddedResource 供托盘 manifest 流读取 -->
    <EmbeddedResource Include="Assets\**\*" />
    <Resource Include="Assets\btc.ico" />
  </ItemGroup>

</Project>

