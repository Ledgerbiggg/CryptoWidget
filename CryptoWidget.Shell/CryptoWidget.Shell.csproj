<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CryptoWidget.Shell</RootNamespace>
    <AssemblyName>CryptoWidget.Shell</AssemblyName>
    <Version>0.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CryptoWidget.Common\CryptoWidget.Common.csproj" />
    <ProjectReference Include="..\CryptoWidget.Models\CryptoWidget.Models.csproj" />
    <ProjectReference Include="..\CryptoWidget.Services\CryptoWidget.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Prism.Unity" Version="8.1.97" />
  </ItemGroup>

  <ItemGroup>
    <!-- tray.ico 供托盘 manifest 流读取；app-icon.png 供窗口图标 pack URI 读取 -->
    <EmbeddedResource Include="Assets\**\*" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

</Project>
