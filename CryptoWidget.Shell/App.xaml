<p:PrismApplication x:Class="CryptoWidget.Shell.App"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="http://prismlibrary.com/"
                    xmlns:conv="clr-namespace:CryptoWidget.Shell.Converter">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 通用转换器 -->
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter" />
            <conv:ChangePercentToBrushConverter x:Key="ChangeToBrushConverter" />
            <conv:ConnectedToBrushConverter x:Key="ConnectedToBrushConverter" />

            <!-- 全局字体：统一中英文渲染 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            </Style>

            <!-- 卡片右上角小按钮（浅色、hover 高亮） -->
            <Style x:Key="CardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#9AA4B2" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 钉按钮：钉住态橙色高亮 -->
            <Style x:Key="PinToggleStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="#9AA4B2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="#F7931A" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 设置窗口复选框/输入框统一留白 -->
            <Style x:Key="SettingsGroupTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F7931A" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,10,0,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</p:PrismApplication>
